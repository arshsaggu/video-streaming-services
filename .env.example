# Copy to .env to override defaults. Contains NO secrets - those live in ./secrets/.

# Image naming (CI pushes ghcr.io/<owner>/vss-<service>:<tag>)
REGISTRY=ghcr.io/your-github-user
TAG=local

# Published ports (the only two services reachable from the host)
UPLOAD_PORT=8081
STREAM_PORT=8082

# App settings
MAX_UPLOAD_MB=500
JWT_TTL_SECONDS=3600
ALLOW_REGISTRATION=true
LOG_LEVEL=info
# Set true when served over HTTPS (behind a TLS proxy)
COOKIE_SECURE=false

# Performance knobs (used for the before/after measurements in docs/REPORT.md)
AUTH_CACHE_TTL_MS=30000
HTTP_KEEPALIVE=true
AUTH_WORKERS=2
# file-service read chunk size for streaming (64 = Node default; see report, improvement 3)
READ_BUFFER_KB=1024
